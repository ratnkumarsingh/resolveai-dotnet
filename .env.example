# Server-side only. Never prefix with VITE_ — nothing here may reach the browser bundle.

# Claude API key. Leave empty to run in recorded mode (deterministic demo, no network).
ANTHROPIC_API_KEY=

# live = call Claude; recorded = replay the committed fixture responses.
# Defaults to "recorded" when ANTHROPIC_API_KEY is empty.
LLM_MODE=recorded

# Claude model used for investigations and RCA drafts.
CLAUDE_MODEL=claude-opus-5-5

# Enables POST /api/demo/reset (accepted from localhost, or with LIVE_ACCESS_CODE).
DEMO_MODE=true

# SQLite file location (relative to api/).
DB_PATH=../data/resolveai.db

API_PORT=8787

# Address to listen on. Keep 127.0.0.1 locally; docker-compose sets 0.0.0.0 inside the container.
HOST=127.0.0.1

# Lets a run opt into live Claude while LLM_MODE stays recorded: the browser must send this code
# (Settings → Access code). Leave empty to disable live runs on request.
LIVE_ACCESS_CODE=

# Maximum live model calls (investigations + RCA drafts) per UTC day.
LIVE_DAILY_LIMIT=20

# --- Systems (one read-only MCP server each: database, files, deploys, metrics) ---
# Turn the MCP systems off entirely (investigations then use the demo dataset only).
MCP_ENABLED=true
# Most extra tool calls Claude may make per live investigation (0-20).
MCP_MAX_FOLLOWUP_CALLS=8
# Which systems and folders to use. Defaults to mcp.config.json, then mcp.config.example.json.
# RESOLVEAI_MCP_CONFIG=
# SQL Server reader login, only for driver "tedious" (SQL login over TCP, e.g. in Docker).
# With driver "msnodesqlv8" on Windows the server uses your Windows sign-in and runs as resolveai_reader.
MSSQL_USER=
MSSQL_PASSWORD=
# MSSQL_ODBC_DRIVER=ODBC Driver 17 for SQL Server
