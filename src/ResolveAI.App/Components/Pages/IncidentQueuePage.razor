@page "/"
@inject AppService Service
@inject NavigationManager Nav

<PageTitle>ResolveAI</PageTitle>

<div class="space-y-4">
    <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
            <h1 class="text-xl font-semibold">Incident queue</h1>
            <p class="text-sm text-slate-500">
                @(_list is not null ? $"{Active} active · {_list.Total} shown" : "Loading incidents…")
            </p>
        </div>
        <div class="flex flex-wrap gap-2">
            <button type="button" aria-pressed="@Ui.Aria(_review)" @onclick="ToggleReview" data-testid="needs-review"
                    class="@Ui.Cx("rounded-full border px-3 py-1 text-sm", _review ? "border-amber-400 bg-amber-100 font-medium text-amber-900" : "border-slate-300 bg-white text-slate-600 hover:bg-slate-50")">
                Needs review
            </button>
            <input type="search" @bind="_q" @bind:event="oninput" @bind:after="Load" placeholder="Search key, title or service" aria-label="Search incidents"
                   class="w-64 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm" />
            <select aria-label="Severity" @bind="_severity" @bind:after="Load" class="@SelectClass">
                <option value="">All severities</option>
                @foreach (var s in new[] { "SEV-1", "SEV-2", "SEV-3", "SEV-4" })
                {
                    <option value="@s">@s</option>
                }
            </select>
            <select aria-label="Status" @bind="_status" @bind:after="Load" class="@SelectClass">
                <option value="">All statuses</option>
                @foreach (var s in new[] { "open", "investigating", "mitigated", "resolved" })
                {
                    <option value="@s">@s</option>
                }
            </select>
            <select aria-label="Service" @bind="_service" @bind:after="Load" class="@SelectClass">
                <option value="">All services</option>
                @foreach (var s in _list?.Services ?? [])
                {
                    <option value="@s">@s</option>
                }
            </select>
        </div>
    </div>

    @if (_error is not null)
    {
        <ErrorBox Message="@_error" OnRetry="Load" />
    }
    @if (_list is { Items.Count: 0 })
    {
        <Empty Title="@(_review ? "Nothing waiting for review" : "No incidents match these filters")">
            @(_review ? "Every investigated incident has a verified root cause and a reviewed RCA." : "Clear the search or filters, or reseed the demo data from Settings.")
        </Empty>
    }

    @if (_list is { Items.Count: > 0 })
    {
        <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
            <table class="w-full text-left text-sm">
                <thead class="border-b border-slate-200 bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
                    <tr>
                        <th class="px-4 py-2">Incident</th>
                        <th class="px-4 py-2">Severity</th>
                        <th class="px-4 py-2">Service</th>
                        <th class="px-4 py-2">Status</th>
                        <th class="px-4 py-2">Review</th>
                        <th class="px-4 py-2">Started</th>
                        <th class="px-4 py-2">Age</th>
                        <th class="px-4 py-2"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var i in _list.Items)
                    {
                        var review = Ui.Review(i.ReviewState);
                        <tr @key="i.Id" class="cursor-pointer hover:bg-slate-50" @onclick="() => Nav.NavigateTo(IncidentUrl(i))">
                            <td class="px-4 py-3">
                                <div class="font-medium text-slate-900">
                                    <span class="font-mono text-xs text-slate-500">@i.Key</span> @i.Title
                                </div>
                                <div class="mt-0.5 line-clamp-1 text-xs text-slate-500">@i.ImpactSummary</div>
                            </td>
                            <td class="px-4 py-3"><SeverityChip Severity="@i.Severity" /></td>
                            <td class="px-4 py-3 font-mono text-xs">@i.ServiceName</td>
                            <td class="px-4 py-3"><StatusChip Status="@i.Status" /></td>
                            <td class="whitespace-nowrap px-4 py-3">
                                <span class="@Ui.Cx("rounded px-1.5 py-0.5 text-xs font-medium", review.Class)" title="@review.Title">@review.Label</span>
                            </td>
                            <td class="whitespace-nowrap px-4 py-3 text-xs text-slate-600">@Ui.FormatTime(i.StartedAt, true)</td>
                            <td class="px-4 py-3 text-xs text-slate-600">@Ui.Age(i.StartedAt)</td>
                            <td class="px-4 py-3 text-right">
                                <a href="@IncidentUrl(i)" @onclick:stopPropagation="true"
                                   class="inline-block whitespace-nowrap rounded-md bg-indigo-600 px-2.5 py-1 text-xs font-medium text-white hover:bg-indigo-700">
                                    Open incident
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private const string SelectClass = "rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm";

    private string _q = "";
    private string _severity = "";
    private string _status = "";
    private string _service = "";
    private bool _review;
    private IncidentList? _list;
    private string? _error;

    private int Active => _list?.Items.Count(i => i.Status != "resolved") ?? 0;
    private static string IncidentUrl(IncidentListItem i) => $"/incidents/{i.Key}";

    protected override void OnInitialized() => Load();

    private void ToggleReview()
    {
        _review = !_review;
        Load();
    }

    private void Load()
    {
        try
        {
            _list = Service.ListIncidents(_status, _severity, _service, _q, _review ? "pending" : null, 1, 25);
            _error = null;
        }
        catch (Exception err)
        {
            _error = Ui.Message(err);
        }
    }
}
