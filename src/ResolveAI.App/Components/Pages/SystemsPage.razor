@page "/systems"
@implements IDisposable
@inject AppService Service

<PageTitle>ResolveAI</PageTitle>

<div class="space-y-6">
    <section class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-indigo-700 via-violet-700 to-fuchsia-700 p-6 text-white shadow-lg sm:p-8">
        <div aria-hidden="true" class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-sky-400/30 blur-3xl"></div>
        <div aria-hidden="true" class="pointer-events-none absolute -bottom-20 left-1/3 h-56 w-56 rounded-full bg-emerald-400/25 blur-3xl"></div>
        <div class="relative">
            <p class="text-xs font-semibold uppercase tracking-widest text-indigo-100">One MCP server per system</p>
            <h1 class="mt-1 text-2xl font-bold sm:text-3xl">Systems the agent can check</h1>
            <p class="mt-2 max-w-2xl text-sm text-indigo-50">
                Each system is a separate, read-only MCP server. There is no tool that runs arbitrary SQL or commands, and nothing here can change a system.
            </p>
            <div class="mt-4 flex flex-wrap gap-2">
                @foreach (var s in SystemStyle.Order)
                {
                    var st = _systems.Systems.FirstOrDefault(x => x.System == s);
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-white/15 px-2.5 py-1 text-xs font-medium ring-1 ring-white/25 backdrop-blur">
                        @if (st is not null)
                        {
                            <StatusDot Status="@st.Status" />
                        }
                        else
                        {
                            <span class="h-2.5 w-2.5 rounded-full bg-white/40"></span>
                        }
                        @SystemStyle.Of(s).Label
                    </span>
                }
            </div>
        </div>
    </section>

    @if (!_systems.Enabled)
    {
        <div class="rounded-lg border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900">
            MCP systems are turned off on this server (MCP_ENABLED=false). Investigations use the demo dataset only.
        </div>
    }

    @if (_systems.Systems.Count > 0)
    {
        <div class="grid gap-4 md:grid-cols-2" data-testid="systems-grid">
            @foreach (var sys in SystemStyle.Order)
            {
                var st = _systems.Systems.FirstOrDefault(x => x.System == sys);
                if (st is null) continue;
                var s = SystemStyle.Of(sys);
                <article class="@Ui.Cx("flex flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm", st.Status == "disabled" ? "opacity-90" : null)" data-testid="system-@sys">
                    <div class="@Ui.Cx("h-1.5", s.Bar)"></div>
                    <div class="flex flex-1 flex-col gap-3 p-4">
                        <header class="flex items-start gap-3">
                            <SystemTile System="@sys" Size="lg" />
                            <div class="min-w-0 flex-1">
                                <h2 class="text-base font-semibold text-slate-900">@st.Label</h2>
                                <p class="text-xs text-slate-500">@s.Label · server <span class="font-mono">@st.Server</span></p>
                            </div>
                            <span class="@Ui.Cx("inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 text-xs font-semibold ring-1",
                                               st.Status switch { "connected" => "bg-emerald-50 text-emerald-800 ring-emerald-200", "error" => "bg-red-50 text-red-800 ring-red-200", _ => "bg-slate-50 text-slate-600 ring-slate-200" })">
                                <StatusDot Status="@st.Status" Pulse="@(st.Status == "connected")" />
                                @(st.Status switch { "connected" => "Connected", "error" => "Not working", _ => "Turned off" })
                            </span>
                        </header>
                        <p class="text-sm text-slate-700">@s.Blurb</p>
                        @if (!string.IsNullOrEmpty(st.Detail))
                        {
                            <p class="@Ui.Cx("rounded-md px-2.5 py-1.5 text-xs", st.Status == "error" ? "bg-red-50 text-red-800" : "bg-slate-50 text-slate-600")">@st.Detail</p>
                        }
                        @if (st.Tools.Count > 0)
                        {
                            <div class="flex flex-wrap gap-1.5">
                                @foreach (var t in st.Tools)
                                {
                                    <span title="@t.Description" class="@Ui.Cx("rounded-md px-2 py-0.5 font-mono text-xs font-medium", s.Chip)">@t.Name</span>
                                }
                            </div>
                        }
                        <p class="mt-auto pt-1 text-[11px] text-slate-400">
                            @st.Tools.Count read-only tool@(st.Tools.Count == 1 ? "" : "s") · checked @Ui.FormatTime(st.CheckedAt, true)
                        </p>
                    </div>
                </article>
            }
        </div>
    }

    <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="text-sm font-semibold text-slate-800">How an investigation uses them</h2>
        <ol class="mt-3 grid gap-3 md:grid-cols-3">
            @foreach (var (n, title, body, tone) in Steps)
            {
                <li class="flex gap-3 rounded-lg bg-slate-50 p-3">
                    <span class="@Ui.Cx("grid h-8 w-8 shrink-0 place-items-center rounded-full bg-gradient-to-br text-sm font-bold text-white shadow-sm", tone)">@n</span>
                    <div>
                        <div class="text-sm font-semibold text-slate-800">@title</div>
                        <p class="text-xs text-slate-600">
                            @body
                            @if (n == 2)
                            {
                                <text> Limit: <strong>@_config.MaxFollowUpCalls</strong> calls per run.</text>
                            }
                        </p>
                    </div>
                </li>
            }
        </ol>
    </section>
</div>

@code {
    private static readonly (int N, string Title, string Body, string Tone)[] Steps =
    [
        (1, "Baseline checks", "ResolveAI always runs the same read-only checks for the incident's service and time window.", "from-sky-500 to-indigo-600"),
        (2, "Follow-up checks", "In live mode Claude may ask a few more narrow questions, within a fixed limit.", "from-violet-500 to-fuchsia-600"),
        (3, "Analysis", "Every result becomes evidence (mcp:N). Findings must cite it, and numbers are checked against it.", "from-emerald-500 to-teal-600"),
    ];

    private SystemsResponse _systems = new() { Enabled = true };
    private AppConfig _config = new();
    private Timer? _timer;

    protected override void OnInitialized()
    {
        _systems = Service.Systems();
        _config = Service.Config();
        _timer = new Timer(_ => InvokeAsync(() =>
        {
            _systems = Service.Systems();
            StateHasChanged();
        }), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    public void Dispose() => _timer?.Dispose();
}
