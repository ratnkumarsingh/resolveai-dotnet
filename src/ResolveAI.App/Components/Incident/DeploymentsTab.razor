@if (Evidence.Deployments.Count == 0)
{
    <Empty Title="No deployments near this incident" />
}
else
{
    var start = Js.ParseDate(Evidence.Incident.StartedAt);
    <div class="space-y-2">
        @foreach (var d in Evidence.Deployments)
        {
            var minutes = (long)Js.Round((start - Js.ParseDate(d.DeployedAt)).TotalMinutes);
            var sameService = d.ServiceName == Evidence.Incident.ServiceName;
            <div @key="d.Id" id="@Ui.RowId(d.Ref)" class="@Ui.Cx("flex flex-wrap items-start gap-3 rounded-lg border border-slate-200 bg-white p-3", Focus == d.Ref ? "flash" : null)">
                <span class="@Ui.Cx("rounded px-1.5 py-0.5 font-mono text-xs", sameService ? "bg-indigo-100 text-indigo-800" : "bg-slate-100 text-slate-600")">
                    @d.ServiceName @d.Version
                </span>
                <div class="min-w-0 flex-1">
                    <div class="text-sm">@d.ChangeSummary</div>
                    <div class="text-xs text-slate-500">
                        @Ui.FormatTime(d.DeployedAt, true) · @d.Environment
                        @if (!string.IsNullOrEmpty(d.CommitRef))
                        {
                            <text> · commit <span class="font-mono">@d.CommitRef</span></text>
                        }
                    </div>
                </div>
                <span class="@Ui.Cx("text-xs font-medium", minutes >= 0 && minutes <= 60 && sameService ? "text-red-700" : "text-slate-500")">
                    @(minutes >= 0 ? $"{(minutes >= 120 ? $"{Js.Num(Js.Round(minutes / 60d))}h" : $"{minutes} min")} before start" : $"{-minutes} min after start")
                </span>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public IncidentEvidence Evidence { get; set; } = new();
    [Parameter] public string? Focus { get; set; }
}
