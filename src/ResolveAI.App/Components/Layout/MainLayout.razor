@inherits LayoutComponentBase
@implements IDisposable
@inject AppService Service
@inject NavigationManager Nav

<div class="min-h-screen">
    <div aria-hidden="true" class="h-1 bg-gradient-to-r from-sky-400 via-fuchsia-400 via-60% to-amber-300"></div>
    <header class="aurora text-white shadow-md">
        <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3">
            <a href="/" class="flex items-center gap-2 font-semibold text-white">
                <span class="grid h-7 w-7 place-items-center rounded-md bg-white text-violet-700 shadow-sm">
                    <svg viewBox="0 0 32 32" class="h-4 w-4" aria-hidden="true">
                        <path d="M7 17l6 6 12-13" stroke="currentColor" stroke-width="4" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </span>
                ResolveAI
            </a>
            <nav class="flex gap-1 text-sm">
                @foreach (var (to, label) in Links)
                {
                    <a href="@to" class="@Ui.Cx("rounded-md px-3 py-1.5", IsActive(to) ? "bg-white font-semibold text-indigo-800 shadow-sm" : "text-indigo-50 hover:bg-white/15 hover:text-white")">@label</a>
                }
            </nav>
            <div class="ml-auto flex items-center gap-2 text-xs">
                <span class="rounded-full bg-amber-100 px-2 py-1 font-medium text-amber-900" title="All incidents, logs and metrics are synthetic seed data">
                    Data source: Demo dataset
                </span>
                <span class="@Ui.Cx("rounded-full px-2 py-1 font-medium", _config.LlmMode == "live" ? "bg-emerald-100 text-emerald-800" : "bg-slate-200 text-slate-700")"
                      title="@(_config.LlmMode == "live" ? "Investigations call Claude" : "Investigations replay recorded/rule-based analysis; no model is called")">
                    LLM: @(_config.LlmMode == "live" ? $"live · {_config.Model}" : _config.LiveAvailable ? "recorded · live on request" : "recorded (offline)")
                </span>
            </div>
        </div>
    </header>
    <main class="mx-auto max-w-7xl px-4 py-6">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private static readonly (string To, string Label)[] Links = [("/", "Incidents"), ("/systems", "Systems"), ("/settings", "Settings & demo data")];

    private AppConfig _config = new();

    protected override void OnInitialized()
    {
        _config = Service.Config();
        Nav.LocationChanged += OnLocationChanged;
    }

    private bool IsActive(string to) => "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0] == to;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _config = Service.Config();
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
