        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "deploys_change_summary",
      "description": "Show what one deployment or commit changed for a service: changed files with line counts and a short patch.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string"
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{4,40}$"
          }
        },
        "required": [
          "service",
          "commit"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    }
  ],
  "metrics": [
    {
      "name": "metrics_list",
      "description": "List the metric names available for a service.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string"
          }
        },
        "required": [
