{
  "name": "resolveai",
  "private": true,
  "version": "0.1.0",
  "description": "ResolveAI — incident investigation copilot (hackathon MVP)",
  "workspaces": [
    "shared",
    "api",
    "web",
    "mcp"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm run dev -w api\" \"npm run dev -w web\"",
    "seed": "npm run seed -w api",
    "build": "npm run build -w web",
    "test": "npm test -w mcp && npm test -w api",
    "typecheck": "tsc -p shared && tsc -p mcp && tsc -p api && tsc -p web",
    "e2e": "playwright test"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@azure/msal-node": "^7.1.2"
  }
}
